# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json

# Generated code (run `dart run build_runner build` after clone — see README)
*.g.dart
*.freezed.dart
*.gr.dart

# Generated localization (regenerated automatically by `flutter pub get`/`flutter run` via l10n.yaml)
lib/core/localization/gen/

# Android release signing (never commit real keystores/credentials)
**/android/key.properties
**/*.jks
**/*.keystore

# Firebase config (per-developer; generate your own via `flutterfire configure`)
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options.dart

# Env files (base URLs/flags are passed via --dart-define, not committed here)
.env
.env.*
